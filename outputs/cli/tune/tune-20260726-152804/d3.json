          "text": "```python\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite not found: {path}\")\n\n    cases: list[PromptCase] = []\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            stripped = line.strip()\n            if not stripped:\n                continue\n            \n            try:\n                data = json.loads(stripped)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON on line {line_num} in {path}: {e}\")\n\n            # Validate required fields\n            if \"id\" not in data or \"category\" not in data or \"prompt\" not in data:\n                raise ValueError(f\"Missing required fields (id, category, prompt) on line {line_num} in {path}\")\n\n            # Type coercion and validation\n            try:\n                case = PromptCase(\n                    id=str(data[\"id\"]),\n                    category=str(data[\"category\"]),\n                    prompt=str(data[\"prompt\"]),\n                    max_tokens=int(data.get(\"max_tokens\", 128)),\n                    notes=str(data.get(\"notes\", \"\"))\n                )\n            except (ValueError, TypeError) as e:\n                raise ValueError(f\"Type conversion error on line {line_num} in {path}: {e}\")\n\n            cases.append(case)\n\n    return cases\n\n\ndef format_prompt(case: PromptCase) -> str:\n    \"\"\"Format a PromptCase into a standard prompt string.\"\"\"\n    return f\"[Category: {case.category}]\\n{case.prompt}\"\n\n\ndef export_results(cases: Iterable[PromptCase], output_path: Path) -> None:\n    \"\"\"Export PromptCases to a JSON file.\"\"\"\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    with output_path.open(\"w\", encoding=\"utf-8\") as f:\n        json.dump([asdict(c) for c in cases], f, indent=2, ensure_ascii=False)\n```",
