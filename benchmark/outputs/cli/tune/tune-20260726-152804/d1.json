          "text": "```python\n    if not path.exists():\n        raise FileNotFoundError(f\"Prompt suite file not found: {path}\")\n    \n    cases: list[PromptCase] = []\n    with path.open(\"r\", encoding=\"utf-8\") as f:\n        for line_num, line in enumerate(f, start=1):\n            stripped = line.strip()\n            if not stripped:\n                continue\n            \n            try:\n                raw = json.loads(stripped)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON on line {line_num}: {e}\") from e\n            \n            # Validate required fields\n            if \"id\" not in raw or \"category\" not in raw or \"prompt\" not in raw:\n                raise ValueError(f\"Line {line_num}: Missing required fields (id, category, prompt). Keys: {list(raw.keys())}\")\n            \n            # Type coercion and validation\n            try:\n                case = PromptCase(\n                    id=str(raw[\"id\"]),\n                    category=str(raw[\"category\"]),\n                    prompt=str(raw[\"prompt\"]),\n                    max_tokens=int(raw.get(\"max_tokens\", 128)),\n                    notes=str(raw.get(\"notes\", \"\"))\n                )\n            except (ValueError, TypeError) as e:\n                raise ValueError(f\"Line {line_num}: Invalid field values - {e}\") from e\n            \n            cases.append(case)\n    \n    return cases\n\n\ndef save_prompt_suite(cases: Iterable[PromptCase], path: Path) -> None:\n    \"\"\"Save a list of PromptCases to a JSONL file.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with path.open(\"w\", encoding=\"utf-8\") as f:\n        for case in cases:\n            f.write(json.dumps(asdict(case), ensure_ascii=False) + \"\\n\")\n\n\ndef filter_cases(cases: Iterable[PromptCase], category: str | None = None, min_tokens: int | None = None) -> list[PromptCase]:\n    \"\"\"Filter cases by category and min_tokens. Returns deterministic order (input order).\"\"\"\n    result: list[PromptCase] = []\n    for case in cases:\n        if category is not None and case.category != category:\n            continue\n        if min_tokens is not None and case.max_tokens < min_tokens:\n            continue\n        result.append(case)\n    return result\n\n\ndef generate",
